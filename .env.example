# Anthropic API key used by /chat's LLM calls. Required.
ANTHROPIC_API_KEY=your-api-key-here

# Optional: point the app at PostgreSQL instead of the default local SQLite
# file (data/metadata.db). docker-compose.yml sets this automatically for
# the `app` service (see the db service below) -- leave unset for local,
# non-Docker development.
# DATABASE_URL=postgresql+psycopg://career_agent:career_agent@localhost:5432/career_agent

# Optional: only used by docker-compose.yml's `db` (PostgreSQL) service to
# set up its user/password/database name. Defaults shown; override if you
# don't want the defaults.
# POSTGRES_USER=career_agent
# POSTGRES_PASSWORD=career_agent
# POSTGRES_DB=career_agent
